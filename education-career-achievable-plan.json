  "sample_achievable_plan": {
    "goal": "Become a Software Engineer",
    "time_horizon": "24 months",
    "milestones": [
      {
        "month_range": "1-3",
        "focus": "Foundations",
        "actions": [
          "Learn one programming language",
          "Practice basic problem solving",
          "Learn Git and GitHub",
          "Build two small projects"
        ],
        "success_measure": "At least 2 completed projects published on GitHub."
      },
      {
        "month_range": "4-6",
        "focus": "Core Development",
        "actions": [
          "Learn data structures and algorithms",
          "Learn SQL and databases",
          "Build one full-stack or substantial application"
        ],
        "success_measure": "One documented project with source code and README."
      },
      {
        "month_range": "7-12",
        "focus": "Portfolio and Experience",
        "actions": [
          "Build 2-3 portfolio projects",
          "Participate in coding challenges",
          "Contribute to an open-source project",
          "Create a professional resume"
        ],
        "success_measure": "Portfolio containing at least 3 strong projects."
      },
      {
        "month_range": "13-18",
        "focus": "Industry Readiness",
        "actions": [
          "Apply for internships",
          "Practice technical interviews",
          "Improve communication skills",
          "Complete a collaborative project"
        ],
        "success_measure": "Regular internship/job applications and interview practice."
      },
      {
        "month_range": "19-24",
        "focus": "Career Launch",
        "actions": [
          "Apply for entry-level roles",
          "Customize resume for each role",
          "Attend career events",
          "Continue technical learning"
        ],
        "success_measure": "Active interview pipeline and applications for suitable entry-level roles."
      }
    ]
  },
