  "project": {
    "name": "Education & Careers: From Aspiration to an Achievable Plan",
    "version": "1.0.0",
    "description": "A structured education and career planning dataset that helps students turn aspirations into achievable, measurable plans.",
    "audience": [
      "school students",
      "college students",
      "graduates",
      "career explorers"
    ]
  },
  "career_planning_framework": {
    "steps": [
      {
        "step": 1,
        "name": "Discover",
        "description": "Identify interests, strengths, values, and career aspirations."
      },
      {
        "step": 2,
        "name": "Explore",
        "description": "Research education options, career roles, required skills, and opportunities."
      },
      {
        "step": 3,
        "name": "Plan",
        "description": "Convert the aspiration into education, skill, and experience milestones."
      },
      {
        "step": 4,
        "name": "Act",
        "description": "Complete courses, projects, internships, certifications, and other planned activities."
      },
      {
        "step": 5,
        "name": "Review",
        "description": "Track progress and update the plan as goals, interests, or opportunities change."
      }
    ]
  },
